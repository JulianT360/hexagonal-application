{
  "request": {
    "method": "GET",
    "urlPath": "/v1/current.json",
    "queryParameters": {
      "key": {
        "equalTo": "test-api-key"
      },
      "q": {
        "equalTo": "2.0,2.0"
      },
      "lang": {
        "equalTo": "es"
      }
