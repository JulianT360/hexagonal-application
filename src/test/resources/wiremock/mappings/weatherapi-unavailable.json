{
  "request": {
    "method": "GET",
    "urlPath": "/v1/current.json",
    "queryParameters": {
      "key": {
        "equalTo": "test-api-key"
      },
      "q": {
        "equalTo": "4.0,4.0"
      },
      "lang": {
        "equalTo": "es"
      }
    }
